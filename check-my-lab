#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
lab_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
if [ ! -x "$lab_root/.runtime/venv/bin/python" ]; then
    printf '%s\n' 'The lab checking tools have not been prepared in this copy.' 'Ask the person who set up your lab to prepare them. Nothing was installed or started.'
    exit 2
fi
exec "$lab_root/.runtime/venv/bin/python" "$lab_root/integrations/stackarr/check_lab.py" "$@"
