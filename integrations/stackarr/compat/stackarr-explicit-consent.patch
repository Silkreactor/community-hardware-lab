     return "\n".join(lines)
 
 
+def _is_stackarr_confirmation_request(params, schema: dict) -> bool:
+    """Recognize the pinned, fully visible one-action boolean consent form.
+
+    This local compatibility boundary deliberately does not fill general forms.
+    Gateway text approvals truncate commands after 200 characters, so longer
+    requests cannot be translated safely until that display path is improved.
+    """
+    expected = {
+        "type": "object",
+        "properties": {
+            "approve": {
+                "type": "boolean",
+                "title": "Approve this action",
+                "description": "Enable only after reviewing the exact action and arguments above.",
+                "default": False,
+            }
+        },
+        "required": ["approve"],
+    }
+    if not isinstance(schema, dict) or schema != expected:
+        return False
+    if schema["properties"]["approve"]["default"] is not False:
+        return False
+    message = getattr(params, "message", None)
+    if getattr(params, "mode", None) != "form" or not isinstance(message, str) or len(message) > 200:
+        return False
+    match = re.fullmatch(
+        r"Stackarr wants to run a destructive action\.\n\nTool: stackarr_[a-z0-9_]+"
+        r"\nCategory: [a-z]+\n\nArguments:\n(\{.*\})",
+        message,
+        re.DOTALL,
+    )
+    if not match:
+        return False
+    try:
+        return isinstance(json.loads(match.group(1)), dict)
+    except (ValueError, TypeError):
+        return False
+
+
